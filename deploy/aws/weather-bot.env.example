# Core mode
WEATHER_BOT_MODE=live_scan
WEATHER_BOT_UNIVERSE=tier1
WEATHER_BOT_RECORD_SCAN=1
WEATHER_BOT_RUNNER_INTERVAL_SECONDS=300
WEATHER_BOT_RUNNER_CYCLES=0

# Networking / API etiquette
WEATHER_BOT_USER_AGENT="weather-polymarket-bot/0.1 (contact: your-email@example.com)"
WEATHER_BOT_INSECURE_SSL=0

# Scan + strategy config (paper mode collection)
# WEATHER_BOT_STRATEGY_ID=weather-baseline-v1

# Calibration pipeline
WEATHER_BOT_FEATURE_ATTACH_OUTCOMES=1
WEATHER_BOT_CAL_DAYS_BACK=30
WEATHER_BOT_CAL_MIN_BIN_SAMPLES=8
WEATHER_BOT_CAL_SHRINKAGE_N=25
WEATHER_BOT_WALKFORWARD_FOLDS=4
WEATHER_BOT_WALKFORWARD_MIN_TRAIN_ROWS=100

# Settlement-triggered calibration refresh (runs only when new settled overlaps are found)
WEATHER_BOT_SETTLEMENT_MIN_NEW_MATCHES=1
# WEATHER_BOT_SETTLEMENT_FORCE=0

# Optional restrictions / tuning
# WEATHER_BOT_CAL_RESTRICT_STATUS=opportunity
# WEATHER_BOT_THRESHOLD_STATUSES=opportunity
# WEATHER_BOT_BT_MAX_SPREAD=0.18
# WEATHER_BOT_BT_SIZE_USD=5

# Runtime calibration (live scan will use this if present)
WEATHER_BOT_CAL_PROFILE_PATH=data/sample/calibration_profile.json

# Live execution scaffold (safe by default)
WEATHER_BOT_EXECUTION_MODE=off
# Modes: off | shadow_submit | dry_run | live_canary
# - shadow_submit: intent logging only
# - dry_run: builds CLOB payloads and logs synthetic submit results (no real orders)
# - live_canary: attempts real CLOB submit (requires SDK + credentials); keep tiny caps
# Set to 1 only when you intentionally want execution mode active
WEATHER_BOT_EXEC_ALLOW=0
# WEATHER_BOT_EXEC_MAX_SCAN_AGE_SECONDS=180
# WEATHER_BOT_EXEC_MIN_CLOSED_TRADES=20
# WEATHER_BOT_EXEC_MIN_TOTAL_PNL_USD=0
# WEATHER_BOT_EXEC_MAX_SUBMITS_PER_SCAN=2
# WEATHER_BOT_EXEC_CANARY_MAX_ORDER_USD=5
# WEATHER_BOT_EXEC_CANARY_MAX_NOTIONAL_PER_SCAN_USD=10
# WEATHER_BOT_EXEC_PRICE_BUFFER=0.01
# WEATHER_BOT_EXEC_ATTEMPT_LOG_PATH=data/sample/live_execution_attempts.jsonl
# WEATHER_BOT_EXEC_STATE_PATH=data/sample/live_execution_state.json
# WEATHER_BOT_EXEC_RESULT_LOG_PATH=data/sample/live_execution_results.jsonl
# WEATHER_BOT_EXEC_POST_ONLY=1
# WEATHER_BOT_EXEC_TIF=GTC

# Real CLOB (only needed for live_canary)
# POLYMARKET_PRIVATE_KEY=0x...
# POLY_CLOB_HOST=https://clob.polymarket.com
# POLY_CHAIN_ID=137

# Paper settlement reconciler outputs (auto-run by settlement trigger every check; settles on Gamma and can mark-exit TP/SL/time-stop)
# WEATHER_BOT_PAPER_SETTLEMENT_STATE=data/sample/paper_settlement_state.json
# WEATHER_BOT_PAPER_SETTLEMENT_LEDGER=data/sample/paper_settlement_ledger.jsonl
# WEATHER_BOT_PAPER_SETTLEMENT_REPORT=data/sample/paper_settlement_report.json
# WEATHER_BOT_PAPER_PERFORMANCE_REPORT=data/sample/paper_performance_report.json
# WEATHER_BOT_PAPER_MARK_EXITS_ENABLED=1
# WEATHER_BOT_PAPER_MARK_MAX_AGE_SECONDS=1800
# WEATHER_BOT_PAPER_TAKE_PROFIT_PCT=0.35
# WEATHER_BOT_PAPER_STOP_LOSS_PCT=0.20
# WEATHER_BOT_PAPER_TIME_STOP_GRACE_SECONDS=300
# Optional regime-specific exit tuning (path can be relative to data/sample base or absolute)
# WEATHER_BOT_PAPER_EXIT_REGIME_PROFILE_PATH=data/sample/paper_exit_regimes.json
# WEATHER_BOT_PAPER_EXIT_REGIME_PROFILE_JSON={"global":{"take_profit_pct":0.35,"stop_loss_pct":0.20}}

# Git autosave (optional but useful on VPS)
GIT_AUTOSAVE_REMOTE=origin
GIT_AUTOSAVE_BRANCH=main
GIT_AUTOSAVE_PUSH=1
GIT_AUTOSAVE_MESSAGE_PREFIX=autosave
# GIT_AUTOSAVE_AUTHOR_NAME=poly-weather-autosave
# GIT_AUTOSAVE_AUTHOR_EMAIL=autosave@local
