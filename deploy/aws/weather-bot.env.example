# Core mode
WEATHER_BOT_MODE=live_scan
WEATHER_BOT_UNIVERSE=tier1
WEATHER_BOT_RECORD_SCAN=1
WEATHER_BOT_RUNNER_INTERVAL_SECONDS=300
WEATHER_BOT_RUNNER_CYCLES=0

# Networking / API etiquette
WEATHER_BOT_USER_AGENT="weather-polymarket-bot/0.1 (contact: your-email@example.com)"
WEATHER_BOT_INSECURE_SSL=0

# Scan + strategy config (paper mode collection)
# WEATHER_BOT_STRATEGY_ID=weather-baseline-v1

# Calibration pipeline
WEATHER_BOT_FEATURE_ATTACH_OUTCOMES=1
WEATHER_BOT_CAL_DAYS_BACK=30
WEATHER_BOT_CAL_MIN_BIN_SAMPLES=8
WEATHER_BOT_CAL_SHRINKAGE_N=25
WEATHER_BOT_WALKFORWARD_FOLDS=4
WEATHER_BOT_WALKFORWARD_MIN_TRAIN_ROWS=100

# Settlement-triggered calibration refresh (runs only when new settled overlaps are found)
WEATHER_BOT_SETTLEMENT_MIN_NEW_MATCHES=1
# WEATHER_BOT_SETTLEMENT_FORCE=0

# Optional restrictions / tuning
# WEATHER_BOT_CAL_RESTRICT_STATUS=opportunity
# WEATHER_BOT_THRESHOLD_STATUSES=opportunity
# WEATHER_BOT_BT_MAX_SPREAD=0.18
# WEATHER_BOT_BT_SIZE_USD=5

# Runtime calibration (live scan will use this if present)
WEATHER_BOT_CAL_PROFILE_PATH=data/sample/calibration_profile.json

# Paper settlement reconciler outputs (auto-run by settlement trigger when new settled overlaps appear)
# WEATHER_BOT_PAPER_SETTLEMENT_STATE=data/sample/paper_settlement_state.json
# WEATHER_BOT_PAPER_SETTLEMENT_LEDGER=data/sample/paper_settlement_ledger.jsonl
# WEATHER_BOT_PAPER_SETTLEMENT_REPORT=data/sample/paper_settlement_report.json

# Git autosave (optional but useful on VPS)
GIT_AUTOSAVE_REMOTE=origin
GIT_AUTOSAVE_BRANCH=main
GIT_AUTOSAVE_PUSH=1
GIT_AUTOSAVE_MESSAGE_PREFIX=autosave
# GIT_AUTOSAVE_AUTHOR_NAME=poly-weather-autosave
# GIT_AUTOSAVE_AUTHOR_EMAIL=autosave@local
