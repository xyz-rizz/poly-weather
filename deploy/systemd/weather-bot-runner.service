[Unit]
Description=Weather Polymarket Bot Runner (paper-mode live scan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/weather-polymarket-bot
Environment=ROOT_DIR=/opt/weather-polymarket-bot
ExecStart=/usr/bin/env bash /opt/weather-polymarket-bot/deploy/aws/run_runner.sh
Restart=always
RestartSec=10
TimeoutStartSec=30

# Journal logs only (default)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

